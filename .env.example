# --- Développement local ---
PORT=4010
FRONTEND_URL=http://localhost:5220

# --- Commun (dev + prod) ---
JWT_SECRET=change-me-in-production

# Clé API OpenAI (platform.openai.com) — nécessaire pour la génération de fiches de révision.
OPENAI_API_KEY=

# --- Production (Vercel) uniquement ---
# Domaine public une fois déployé, ex: https://skoolz.club — sert au CORS et au flux QR code.
PUBLIC_URL=

# Base de données Turso (turso.tech, gratuit) — laisser vide en local, un fichier SQLite est utilisé à la place.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Stockage fichiers Vercel Blob (dashboard Vercel > Storage > Blob) — laisser vide en local,
# le disque local est utilisé à la place.
BLOB_READ_WRITE_TOKEN=
