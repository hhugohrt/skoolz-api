# --- Développement local ---
PORT=4010
FRONTEND_URL=http://localhost:5220

# --- Commun (dev + prod) ---
JWT_SECRET=change-me-in-production

# Clé API OpenAI (platform.openai.com) — nécessaire pour la génération de fiches de révision.
OPENAI_API_KEY=

# --- Production (Vercel) uniquement ---
# Domaine public une fois déployé, ex: https://skoolz.club — sert au CORS et au flux QR code.
PUBLIC_URL=

# Base de données : crée une base "Vercel Postgres" depuis l'onglet Storage du projet sur
# vercel.com, une fois liée au projet Vercel ajoute automatiquement POSTGRES_URL — rien à
# copier toi-même. Laisser vide en local, un fichier SQLite est utilisé à la place.
POSTGRES_URL=

# Stockage fichiers : crée une base "Blob" depuis le même onglet Storage — ajoute automatiquement
# BLOB_READ_WRITE_TOKEN. Laisser vide en local, le disque local est utilisé à la place.
BLOB_READ_WRITE_TOKEN=

# Connexion avec Google (Google Cloud Console > API et services > Identifiants > ID client OAuth "Application Web").
# C'est un identifiant public : le même que VITE_GOOGLE_CLIENT_ID côté front. Sans lui, la route /api/auth/google répond 503.
GOOGLE_CLIENT_ID=

# Plafond de générations de fiches par élève et par 24 h (protège la facture OpenAI). Défaut : 15 (abonnés).
DAILY_GENERATION_LIMIT=15

# E-mails (mot de passe oublié, confirmation d'adresse) via Resend : https://resend.com
# Crée une clé API et vérifie le domaine skoolz.club (enregistrements DNS chez OVH).
# EMAIL_FROM doit être une adresse de ce domaine, ex : Skoolz <noreply@skoolz.club>.
RESEND_API_KEY=
EMAIL_FROM=
# URL publique utilisée dans les liens des e-mails (défaut : PUBLIC_URL).
APP_URL=

# Paiements (abonnements) via Whop : https://whop.com/dashboard
# WHOP_API_KEY : clé API de l'entreprise (permissions checkout_configuration:create/read).
# WHOP_PLAN_MONTHLY / WHOP_PLAN_YEARLY : identifiants (plan_…) des deux formules créées dans Whop (7,99 €/mois, 49,99 €/an, renouvellement automatique).
# WHOP_WEBHOOK_SECRET : secret (ws_…) du webhook pointant sur https://api.skoolz.club/api/billing/webhook
#   avec les événements payment.succeeded et membership.deactivated.
WHOP_API_KEY=
WHOP_PLAN_MONTHLY=
WHOP_PLAN_YEARLY=
WHOP_WEBHOOK_SECRET=

# Générations de fiches par 24 h : abonnés (DAILY_GENERATION_LIMIT, défaut 15) et comptes gratuits
# (FREE_DAILY_GENERATIONS, défaut 2 ; mettre 0 pour interdire toute génération sans abonnement).
FREE_DAILY_GENERATIONS=2

# Comptes considérés comme abonnés sans paiement (adresses séparées par des virgules) : propriétaire, testeurs.
PREMIUM_EMAILS=

# Administrateurs (page /app/admin) : adresses séparées par des virgules. L adresse doit être confirmée.
ADMIN_EMAILS=
